# Node / npm — extensions import their deps (e.g. typebox) from pi's own
# bundle at runtime, so per-extension node_modules is a test artifact only.
# Never commit it; it bloats the repo and the image (Dockerfile COPYs these
# dirs into /opt/pa/extensions).
node_modules/
npm-debug.log*
.npm/

# pi session files (pa launches pi with --session-dir "$PWD/.pi-sessions")
.pi-sessions/

# pa-rag index store (SQLite + vectors). Machine-generated and multi-MB;
# rebuilt on demand from the working tree.
.pirag/

# Build / test scratch
*.tsbuildinfo
/tmp/

# smoketest fixture dirs. Created under the repo root on purpose (macOS TMPDIR is
# outside Docker Desktop's shared paths, so a bind mount from there is empty) and
# removed by the cleanup trap -- these patterns only catch a crashed run.
/.pa-smoke-pkg.*
/.pa-smoke-auth.*
/.pa-smoke-sim.*

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/
